/* SchoolSafe V2 — Prototype V3
   Harmonisation chromatique de l'espace interne uniquement.
   Aucun changement de géométrie, animation, texte ou comportement. */

.workspace-screen {
  --navy-950:#06152f;
  --navy-900:#0b2452;
  --navy-800:#12366f;
  --blue-600:#315fce;
  --blue-100:#e7edfb;
  --gold-500:#d6a43a;
  --gold-100:#f9eed4;
  --emerald-600:#1f8a68;
  --emerald-100:#e3f4ed;
  --violet-600:#7758bb;
  --violet-100:#f0eafb;
  --coral-600:#c45155;
  --coral-100:#fbe9ea;
  --ink:#17213a;
  --muted:#69748a;
  --line:#dfe5ef;
  --surface:#ffffff;
  --canvas:#f4f6fb;
  color:var(--ink);
  background:#eef3fb;
}

.workspace-screen .workspace-sidebar {
  color:#ffffff;
  background:linear-gradient(180deg,#0c2a67 0%,#071b45 100%);
  border-right-color:#315fce;
}
.workspace-screen .workspace-brand strong { color:#d6a43a; }
.workspace-screen .workspace-school {
  border-top-color:rgba(255,255,255,.13);
  border-bottom-color:rgba(255,255,255,.13);
}
.workspace-screen .workspace-school span { color:rgba(255,255,255,.54); }
.workspace-screen .workspace-nav button,
.workspace-screen .workspace-back { color:rgba(255,255,255,.72); }
.workspace-screen .workspace-nav button:hover,
.workspace-screen .workspace-back:hover {
  color:#ffffff;
  background:rgba(255,255,255,.08);
}
.workspace-screen .workspace-nav button.active {
  color:#ffffff;
  background:linear-gradient(135deg,#315fce,#7658c8);
}
.workspace-screen .sidebar-language,
.workspace-screen .permissions-nav {
  border-color:rgba(255,255,255,.15);
  background:rgba(255,255,255,.05);
}
.workspace-screen .sidebar-language > div > span,
.workspace-screen .sidebar-language label { color:rgba(255,255,255,.72); }
.workspace-screen .sidebar-language select {
  color:#ffffff;
  background:#18396f;
  border-color:rgba(255,255,255,.2);
}
.workspace-screen .permissions-nav { color:rgba(255,255,255,.78); }
.workspace-screen .permissions-nav:hover {
  color:#ffffff;
  background:rgba(255,255,255,.1);
}
.workspace-screen .workspace-back { border-top-color:rgba(255,255,255,.13); }

.workspace-screen .workspace-main {
  background:linear-gradient(135deg,#f8faff,#edf2fa);
}
.workspace-screen .workspace-topbar {
  background:#ffffff;
  border-bottom-color:#dfe5ef;
}
.workspace-screen .workspace-heading span { color:#69748a; }
.workspace-screen .workspace-role-switch,
.workspace-screen .profile-button {
  color:#26334f;
  background:#ffffff;
  border-color:#dfe5ef;
}
.workspace-screen .profile-button > span {
  color:#ffffff;
  background:#0b2452;
}

.workspace-screen .sync-status-button.is-online {
  color:#1f7b60;
  background:#f0f8f5;
  border-color:#b9d9ce;
}
.workspace-screen .sync-status-button.is-online small { color:#5f756d; }
.workspace-screen .sync-status-button.is-offline {
  color:#8a6417;
  background:#fff8e9;
  border-color:#e6c878;
}
.workspace-screen .sync-status-button.is-syncing {
  color:#315fce;
  background:#eef3fd;
  border-color:#b7c8ee;
}
.workspace-screen .sync-status-button.has-conflict {
  color:#a64348;
  background:#fff1f1;
  border-color:#e5b2b5;
}

.workspace-screen .workspace-welcome {
  color:#ffffff;
  background:linear-gradient(135deg,#12366f,#315fce);
  border-color:#4d79d2;
}
.workspace-screen .workspace-welcome p { color:rgba(255,255,255,.72); }
.workspace-screen .dark-label { background:rgba(255,255,255,.11); }
.workspace-screen .overview-stat {
  color:#ffffff;
  background:rgba(5,20,49,.22);
  border-color:rgba(255,255,255,.18);
}
.workspace-screen .overview-stat > span { color:#ffffff; }

.workspace-screen .metric-grid article,
.workspace-screen .protected-module,
.workspace-screen .access-console,
.workspace-screen .certification-table-card,
.workspace-screen .candidate-file,
.workspace-screen .certification-preparation,
.workspace-screen .certification-results,
.workspace-screen .certification-parent,
.workspace-screen .certification-stages,
.workspace-screen .remediation-list,
.workspace-screen .remediation-case-detail,
.workspace-screen .remediation-finance,
.workspace-screen .remediation-schedule,
.workspace-screen .remediation-reports,
.workspace-screen .remediation-parent {
  background:#ffffff;
  border-color:#dfe5ef;
}
.workspace-screen .metric-icon.blue {
  color:#315fce;
  background:#e7edfb;
}
.workspace-screen .metric-icon.green {
  color:#1f8a68;
  background:#e3f4ed;
}
.workspace-screen .metric-icon.gold {
  color:#9a6b12;
  background:#f9eed4;
}
.workspace-screen .metric-icon.purple {
  color:#7758bb;
  background:#f0eafb;
}
.workspace-screen .protected-module { border-color:#bfe0d3; }
.workspace-screen .protected-state {
  color:#1f8a68;
  background:#e3f4ed;
}
.workspace-screen .scope-note {
  color:#405a78;
  background:#f3f7fc;
  border-color:#d8e3f2;
}
.workspace-screen .scope-note b { color:#0b2452; }

.workspace-screen .action-button:hover,
.workspace-screen .action-button.action-selected {
  border-color:var(--branch-color);
  color:var(--branch-color);
  background:var(--branch-bg);
}

.workspace-screen .certification-table-card > header,
.workspace-screen .certification-preparation > header,
.workspace-screen .certification-results > header,
.workspace-screen .certification-stages > header,
.workspace-screen .remediation-list > header,
.workspace-screen .remediation-reports > header,
.workspace-screen .remediation-finance > header,
.workspace-screen .remediation-schedule > header {
  background:#f8fafc;
  border-bottom-color:#e3e8f0;
}
.workspace-screen .certification-table th { background:#f1f4f9; color:#5c677b; }
.workspace-screen .certification-table td { color:#334057; border-top-color:#e7ebf1; }
.workspace-screen .candidate-file > header,
.workspace-screen .certification-parent > header {
  color:#ffffff;
  background:linear-gradient(120deg,#102f68,#315fce);
}
.workspace-screen .candidate-file > header small,
.workspace-screen .certification-parent > header span:not(.case-status) {
  color:#c4d8fb;
}
.workspace-screen .free-makeup-note,
.workspace-screen .candidate-file > aside,
.workspace-screen .certification-parent > aside {
  color:#176d56;
  background:#f0f8f5;
  border-color:#bfddd2;
}
.workspace-screen .certification-boundary,
.workspace-screen .certification-stages > footer,
.workspace-screen .certification-results > footer {
  color:#7d5e17;
  background:#fff8e9;
  border-color:#e5cf91;
}
.workspace-screen .certification-metrics article {
  background:#f5f8fc;
  border-left-color:#315fce;
}
.workspace-screen .certification-metrics article:nth-child(2) { border-left-color:#1f8a68; }
.workspace-screen .certification-metrics article:nth-child(3) { border-left-color:#7758bb; }
.workspace-screen .certification-metrics article:nth-child(4) { border-left-color:#d6a43a; }

.workspace-screen .bulletin-metrics article { background:#f5f8fc; }
.workspace-screen .bulletin-metrics article:nth-child(1) { border-left-color:#315fce; }
.workspace-screen .bulletin-metrics article:nth-child(2) { border-left-color:#1f8a68; }
.workspace-screen .bulletin-metrics article:nth-child(3) { border-left-color:#c45155; }
.workspace-screen .bulletin-metrics article:nth-child(4) { border-left-color:#7758bb; }
.workspace-screen .period-card { border-color:#dfe5ef; }
.workspace-screen .period-card > header { background:#f7f9fc; }
.workspace-screen .period-card > header > span { color:#ffffff; background:#748096; }
.workspace-screen .period-card.closed > header > span { background:#1f8a68; }

/* Le cube 3D garde sa palette visuelle d'origine. */
.workspace-screen .cube-face {
  background-color:#071a3d;
  border-color:rgba(255,255,255,.56);
}
